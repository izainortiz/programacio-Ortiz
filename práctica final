# Ahora si empieza el juego
intentos = 10

codigo_secreto = codigo_usuario = ''
while intentos > 0:
    print('Tienes', intentos, 'intentos restantes.\n')
    print('Por favor, ingresa tu intento de código secreto (por ejemplo: verde rojo morado naranja):\n')
    codigo_usuario = input()
    if codigo_usuario == codigo_secreto:
        print('¡Felicidades! Has adivinado el código secreto.')
        break
    else:
        print('Lo siento, ese no es el código secreto. Intenta de nuevo.\n')
        intentos -= 1
        print('Te quedan', intentos, 'intentos.\n')









