# Introducción al juego de adivinanza de números
print(' Bienvenido a Mastermind')
# Iniciar el juego
print('Jugar al Mastermind')
input('Presiona Enter para comenzar')
# El juego ya ha comenzado/reglamentos
print('El juego ha comenzado\n')
print('Tienes 10 intentos para adivinar el número secreto entre 1 y 100.\n')
print('Después de cada intento, recibirás pistas sobre si tu número es demasiado alto o demasiado bajo.\n')
print('Tienes seis colores para elegir: rojo, azul, verde, amarillo, naranja y morado.\n')
print('Cada color representa una letra del código secreto.\n')
print('El código secreto tiene cuatro letras y puede contener letras repetidas.\n')
# Ahora si empieza el juego
intentos = 10
colores = ['rojo', 'azul', 'verde', 'amarillo', 'naranja', 'morado']  
codigo_secreto = ('verde rojo morado naranja')  # Ejemplo de código secreto
codigo_usuario = ''
while intentos > 0:
    print('Tienes', intentos, 'intentos restantes.\n')
    print('Por favor, ingresa tu intento de código secreto (por ejemplo: verde rojo morado naranja):\n')
    codigo_usuario = input()
    if codigo_usuario == codigo_secreto:
        print('¡Felicidades! Has adivinado el código secreto.')
        break
    else:
        print('Lo siento, ese no es el código secreto. Intenta de nuevo.\n')
        intentos -= 1
        print('Te quedan', intentos, 'intentos.\n')
        # Separar los colores sin definir una función dentro del bucle.
        secreto = codigo_secreto.split()
        intento = codigo_usuario.lower().split()
        if len(intento) != 4:
            print('El código debe tener exactamente cuatro colores.\n')
            continue
        correctas = 0
        semicorrectas = 0
        secreto_contado = [False, False, False, False]
        intento_correcto = [False, False, False, False]

        # Primero contamos los colores en la posición correcta.
        for i in range(4):
            if intento[i] == secreto[i]:
                correctas += 1
                secreto_contado[i] = True
                intento_correcto[i] = True

        # Después contamos colores correctos en una posición distinta.
        for i in range(4):
            encontrado = False
            for j in range(4):
                if intento_correcto[i] == False and secreto_contado[j] == False and intento[i] == secreto[j] and encontrado == False:
                    semicorrectas += 1
                    secreto_contado[j] = True
                    encontrado = True

        mal = 4 - correctas - semicorrectas
        pistas = (['• (correcta)'] * correctas
                  + ['o (semicorrecta)'] * semicorrectas
                  + ['· (mal)'] * mal)
        print('Pistas:', ' '.join(pistas))























